# Deep Research Configuration
# Copy this to .env and fill in your values

# ============================================================
# AI Provider — which service to use for analysis
# Supported: anthropic | openai | deepseek | openai_compatible
# ============================================================
AI_PROVIDER=anthropic

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6-20250514
# ANTHROPIC_MAX_TOKENS=64000
# ANTHROPIC_THINKING_BUDGET=16000

# OpenAI (GPT-4.1, GPT-4o, etc.)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1
# OPENAI_MAX_TOKENS=16000

# DeepSeek (uses OpenAI-compatible API)
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_MAX_TOKENS=16000

# Generic OpenAI-compatible (Ollama, vLLM, LM Studio, etc.)
# OPENAI_COMPATIBLE_API_KEY=not-needed
# OPENAI_COMPATIBLE_MODEL=llama3
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPATIBLE_MAX_TOKENS=16000

# Optional: Reddit API credentials (falls back to scraping if not set)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=deep-research-tool/1.0

# Optional: Customize search behavior
# SEARCH_LIMIT_PER_SOURCE=20
# SEARCH_TIMEOUT_SECONDS=60.0
